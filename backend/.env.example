# ═══════════════════════════════════════════════════════════════════
# Behavioral Agentic AI - Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════════════════
DATABASE_URL=sqlite:///./data/app.db
# For PostgreSQL: postgresql://user:password@localhost:5432/behavioral_ai

# ═══════════════════════════════════════════════════════════════════
# LLM Configuration — Provider-Agnostic
# Supports any OpenAI-compatible API. Just change these 3 values:
#
#   Provider        LLM_BASE_URL                        LLM_MODEL                                    LLM_API_KEY
#   ─────────       ──────────────────────────           ──────────────────────────────────            ──────────────
#   fal.ai          https://fal.ai/api/v1               deepseek-r1                                  fal-xxxxx
#   OpenRouter      https://openrouter.ai/api/v1        meta-llama/llama-3.3-70b-instruct:free       sk-or-xxxxx
#   OpenAI          https://api.openai.com/v1           gpt-4o-mini                                  sk-xxxxx
#   Claude (proxy)  https://api.anthropic.com/v1        claude-sonnet-4-20250514                  sk-ant-xxxxx
#   Together AI     https://api.together.xyz/v1         deepseek-ai/DeepSeek-R1                      tg-xxxxx
#   Groq            https://api.groq.com/openai/v1      llama-3.3-70b-versatile                      gsk_xxxxx
# ═══════════════════════════════════════════════════════════════════
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://fal.ai/api/v1
LLM_MODEL=deepseek-r1
LLM_FALLBACK_MODEL=deepseek-v3

# ═══════════════════════════════════════════════════════════════════
# SECURITY — JWT Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ═══════════════════════════════════════════════════════════════════
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production

# ═══════════════════════════════════════════════════════════════════
# Google Generative AI (optional — Gemini API for embeddings)
# ═══════════════════════════════════════════════════════════════════
GOOGLE_API_KEY=your-google-gemini-api-key

# ═══════════════════════════════════════════════════════════════════
# Vector Database Configuration
# ═══════════════════════════════════════════════════════════════════
VECTOR_STORE_DIR=./data/vector_store

# ═══════════════════════════════════════════════════════════════════
# Embedding Model
# ═══════════════════════════════════════════════════════════════════
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ═══════════════════════════════════════════════════════════════════
# APPLICATION
# ═══════════════════════════════════════════════════════════════════
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=production
