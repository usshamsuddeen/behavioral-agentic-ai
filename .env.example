# ═══════════════════════════════════════════════════════════════════
# Behavioral Agentic AI — Environment Configuration
# Copy to .env and customize: cp .env.example .env
# ═══════════════════════════════════════════════════════════════════

# ── Database ────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/app.db

# ── Security (CHANGE IN PRODUCTION!) ───────────────────────────
JWT_SECRET_KEY=change-this-to-a-random-64-character-string
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"

# ── LLM Provider ───────────────────────────────────────────────
# Supports: OpenRouter, OpenAI, Anthropic (any OpenAI-compatible API)
LLM_API_KEY=your-api-key-here
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_FALLBACK_MODEL=mistralai/mistral-7b-instruct:free

# ── Vector Store / Embeddings ──────────────────────────────────
VECTOR_STORE_DIR=data/vector_store
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ── CORS (comma-separated allowed origins) ─────────────────────
CORS_ORIGINS=*

# ── Application ────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Public URL (used for widget embed code generation) ─────────
BACKEND_URL=http://localhost:8000
