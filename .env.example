# ═══════════════════════════════════════════════════════════════════
# Environment Variables — Copy to .env and customize
# ═══════════════════════════════════════════════════════════════════

# ── Database ────────────────────────────────────────────────────
# Local development (SQLite — default, zero setup)
DATABASE_URL=sqlite:///./data/app.db

# Production (uncomment for Docker / PostgreSQL)
# DATABASE_URL=postgresql://postgres:changeme123@postgres:5432/behavioral_ai
# POSTGRES_PASSWORD=changeme123

# ── Redis (optional — only needed in Docker) ───────────────────
# REDIS_HOST=redis
# REDIS_PORT=6379

# ── Security (CHANGE THESE IN PRODUCTION!) ─────────────────────
JWT_SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
SECRET_KEY=change-this-to-a-random-secure-key-in-production

# ── AI / LLM ───────────────────────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key-here
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── CORS (comma-separated allowed origins) ─────────────────────
CORS_ORIGINS=http://localhost:5500,http://localhost:3000,http://localhost:80

# ── Application ────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ── NLP Settings ───────────────────────────────────────────────
SENTIMENT_CONFIDENCE_THRESHOLD=0.7
ESCALATION_THRESHOLD=0.75

# ── Feature Flags ──────────────────────────────────────────────
ENABLE_BERT_MODEL=false
ENABLE_REDIS_CACHE=false
ENABLE_WEBSOCKET=true
ENABLE_AUTO_REPLY=true
