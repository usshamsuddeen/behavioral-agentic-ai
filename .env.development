# Development Environment Variables
# Copy this file to .env for local development

# Database Configuration (SQLite for development)
DATABASE_URL=sqlite:///./data/app.db

# Redis Configuration (Optional for development)
REDIS_HOST=localhost
REDIS_PORT=6379

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=DEBUG
DEBUG=true

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:5500

# Security (Development only - change in production!)
SECRET_KEY=dev-secret-key-not-for-production

# NLP Model Settings
NLP_MODEL_CACHE_DIR=./models
SENTIMENT_CONFIDENCE_THRESHOLD=0.7
ESCALATION_THRESHOLD=0.70

# Performance Tuning
REDIS_MAX_MEMORY=128mb

# Feature Flags
ENABLE_BERT_MODEL=true
ENABLE_REDIS_CACHE=false  # Optional in dev
ENABLE_WEBSOCKET=true
ENABLE_AUTO_REPLY=true
